# OpenAI API key for Whisper + future AI features
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=verse

# Twilio credentials (live, not test)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Where voicemail notifications go
VOICEMAIL_TO=your_destination_email@example.com

# Base URL for your public tunnel (ngrok) - set at runtime
NGROK_BASE_URL=https://your-ngrok-url.ngrok-free.dev
